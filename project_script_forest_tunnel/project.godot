; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="VJ Script: Forest to Light Tunnel"
config/description="Worked example: forest to light tunnel with a splitting screen. Edit main.tscn, then Tools > VJ: Preview in player (or the 3D toolbar button) to export to scripts/forest_tunnel/video.json and play it."
config/version="0.1.0-dev"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[editor_plugins]

enabled=PackedStringArray("res://addons/vj_editor/plugin.cfg")
