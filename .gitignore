# Godot 4+ specific ignores
.godot/
*/.godot/

# Godot UID cache files (auto-regenerated by the editor)
*.uid

# Third-party addon — install manually from release, see README
project_engine/addons/godot-xr-tools/

# Godot-specific ignores
.import/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Build output
build/
bin/
*.exe
*.pdb
*.exp
*.lib
*.obj

# System / editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp
*.log
*.tmp
*~*.TMP

# Video assets (not tracked in repo)
*.mp4
*.mkv
*.mov
*.avi
*.webm
*.m4v
*.wmv
*.flv

# Junctions to shared addons (point at addon_vj/ and project_engine/addons/)
project_script_example/addons/vj_editor
project_script_forest_tunnel/addons/vj_editor
project_script_forest_tunnel/addons/gde_gozen
